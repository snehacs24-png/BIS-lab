        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ==========================================\n",
        "# 1. INITIALIZATION\n",
        "# ==========================================\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "n_cities = 20\n",
        "n_ants = 30\n",
        "iterations = 150\n",
        "\n",
        "# Generate random city coordinates\n",
        "cities = np.random.rand(n_cities, 2) * 100\n",
        "\n",
        "# Calculate distance matrix\n",
        "distance = np.zeros((n_cities, n_cities))\n",
        "\n",
        "for i in range(n_cities):\n",
        "    for j in range(n_cities):\n",
        "        distance[i, j] = np.linalg.norm(\n",
        "            cities[i] - cities[j]\n",
        "        )\n",
        "\n",
        "# Calculate route length\n",
        "def route_length(route):\n",
        "    total = 0\n",
        "    for i in range(len(route)):\n",
        "        total += distance[\n",
        "            route[i],\n",
        "            route[(i + 1) % len(route)]\n",
        "        ]\n",
        "    return total\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 2. ANT COLONY OPTIMIZATION\n",
        "# ==========================================\n",
        "\n",
        "def ACO():\n",
        "\n",
        "    alpha = 1\n",
        "    beta = 5\n",
        "    evaporation = 0.5\n",
        "    Q = 100\n",
        "\n",
        "    pheromone = np.ones((n_cities, n_cities))\n",
        "\n",
        "    best_route = None\n",
        "    best_distance = float(\"inf\")\n",
        "\n",
        "    convergence = []\n",
        "\n",
        "    for iteration in range(iterations):\n",
        "\n",
        "        all_routes = []\n",
        "        all_distances = []\n",
        "\n",
        "        for ant in range(n_ants):\n",
        "\n",
        "            start = np.random.randint(n_cities)\n",
        "            route = [start]\n",
        "            unvisited = list(range(n_cities))\n",
        "            unvisited.remove(start)\n",
        "\n",
        "            while unvisited:\n",
        "\n",
        "                current = route[-1]\n",
        "\n",
        "                probabilities = []\n",
        "\n",
        "                for city in unvisited:\n",
        "\n",
        "                    tau = pheromone[current][city] ** alpha\n",
        "                    eta = (1 / (distance[current][city] + 1e-10)) ** beta\n",
        "\n",
        "                    probabilities.append(tau * eta)\n",
        "\n",
        "                probabilities = np.array(probabilities)\n",
        "                probabilities /= probabilities.sum()\n",
        "\n",
        "                next_city = np.random.choice(\n",
        "                    unvisited,\n",
        "                    p=probabilities\n",
        "                )\n",
        "\n",
        "                route.append(next_city)\n",
        "                unvisited.remove(next_city)\n",
        "\n",
        "            d = route_length(route)\n",
        "\n",
        "            all_routes.append(route)\n",
        "            all_distances.append(d)\n",
        "\n",
        "            if d < best_distance:\n",
        "                best_distance = d\n",
        "                best_route = route.copy()\n",
        "\n",
        "        # Evaporate pheromone\n",
        "        pheromone *= (1 - evaporation)\n",
        "\n",
        "        # Deposit pheromone\n",
        "        for route, d in zip(all_routes, all_distances):\n",
        "\n",
        "            for i in range(n_cities):\n",
        "\n",
        "                a = route[i]\n",
        "                b = route[(i + 1) % n_cities]\n",
        "\n",
        "                pheromone[a][b] += Q / d\n",
        "                pheromone[b][a] += Q / d\n",
        "\n",
        "        convergence.append(best_distance)\n",
        "\n",
        "    return best_route, best_distance, convergence\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 3. GENETIC ALGORITHM\n",
        "# ==========================================\n",
        "\n",
        "def GA():\n",
        "\n",
        "    population_size = 50\n",
        "    population = [\n",
        "        np.random.permutation(n_cities)\n",
        "        for _ in range(population_size)\n",
        "    ]\n",
        "\n",
        "    best_distance = float(\"inf\")\n",
        "    convergence = []\n",
        "\n",
        "    for iteration in range(iterations):\n",
        "\n",
        "        scores = np.array([\n",
        "            route_length(route)\n",
        "            for route in population\n",
        "        ])\n",
        "\n",
        "        idx = np.argmin(scores)\n",
        "\n",
        "        if scores[idx] < best_distance:\n",
        "            best_distance = scores[idx]\n",
        "\n",
        "        # Elitism\n",
        "        new_population = [\n",
        "            population[idx].copy()\n",
        "        ]\n",
        "\n",
        "        while len(new_population) < population_size:\n",
        "\n",
        "            p1 = population[\n",
        "                np.random.randint(population_size)\n",
        "            ]\n",
        "\n",
        "            p2 = population[\n",
        "                np.random.randint(population_size)\n",
        "            ]\n",
        "\n",
        "            # Ordered crossover\n",
        "            a, b = sorted(\n",
        "                np.random.choice(n_cities, 2, replace=False)\n",
        "            )\n",
        "\n",
        "            child = np.full(n_cities, -1)\n",
        "\n",
        "            child[a:b+1] = p1[a:b+1]\n",
        "\n",
        "            remaining = [\n",
        "                x for x in p2 if x not in child\n",
        "            ]\n",
        "\n",
        "            positions = [\n",
        "                i for i in range(n_cities)\n",
        "                if child[i] == -1\n",
        "            ]\n",
        "\n",
        "            for pos, city in zip(positions, remaining):\n",
        "                child[pos] = city\n",
        "\n",
        "            # Mutation\n",
        "            if np.random.rand() < 0.2:\n",
        "                x, y = np.random.choice(\n",
        "                    n_cities, 2, replace=False\n",
        "                )\n",
        "                child[x], child[y] = child[y], child[x]\n",
        "\n",
        "            new_population.append(child)\n",
        "\n",
        "        population = new_population\n",
        "        convergence.append(best_distance)\n",
        "\n",
        "    return convergence\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 4. PARTICLE SWARM OPTIMIZATION\n",
        "# ==========================================\n",
        "\n",
        "def PSO():\n",
        "\n",
        "    particles = 40\n",
        "    w = 0.7\n",
        "    c1 = 1.5\n",
        "    c2 = 1.5\n",
        "\n",
        "    position = np.random.rand(particles, n_cities)\n",
        "    velocity = np.random.uniform(\n",
        "        -0.1, 0.1, (particles, n_cities)\n",
        "    )\n",
        "\n",
        "    def decode(x):\n",
        "        return np.argsort(x)\n",
        "\n",
        "    pbest = position.copy()\n",
        "\n",
        "    pbest_scores = np.array([\n",
        "        route_length(decode(x))\n",
        "        for x in position\n",
        "    ])\n",
        "\n",
        "    g_idx = np.argmin(pbest_scores)\n",
        "    gbest = pbest[g_idx].copy()\n",
        "\n",
        "    best_distance = pbest_scores[g_idx]\n",
        "    convergence = []\n",
        "\n",
        "    for iteration in range(iterations):\n",
        "\n",
        "        for i in range(particles):\n",
        "\n",
        "            r1 = np.random.rand(n_cities)\n",
        "            r2 = np.random.rand(n_cities)\n",
        "\n",
        "            velocity[i] = (\n",
        "                w * velocity[i]\n",
        "                + c1 * r1 * (pbest[i] - position[i])\n",
        "                + c2 * r2 * (gbest - position[i])\n",
        "            )\n",
        "\n",
        "            velocity[i] = np.clip(\n",
        "                velocity[i], -1, 1\n",
        "            )\n",
        "\n",
        "            position[i] += velocity[i]\n",
        "\n",
        "            position[i] = np.clip(\n",
        "                position[i], -5, 5\n",
        "            )\n",
        "\n",
        "            score = route_length(\n",
        "                decode(position[i])\n",
        "            )\n",
        "\n",
        "            if score < pbest_scores[i]:\n",
        "\n",
        "                pbest[i] = position[i].copy()\n",
        "                pbest_scores[i] = score\n",
        "\n",
        "                if score < best_distance:\n",
        "                    best_distance = score\n",
        "                    gbest = position[i].copy()\n",
        "\n",
        "        convergence.append(best_distance)\n",
        "\n",
        "    return convergence\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 5. RUN ALL ALGORITHMS\n",
        "# ==========================================\n",
        "\n",
        "aco_route, aco_distance, aco_curve = ACO()\n",
        "\n",
        "ga_curve = GA()\n",
        "\n",
        "pso_curve = PSO()\n",
        "\n",
        "print(\"ACO Best Route:\", aco_route)\n",
        "print(\"ACO Best Distance:\", round(aco_distance, 2))\n",
        "\n",
        "print(\"GA Best Distance:\", round(min(ga_curve), 2))\n",
        "print(\"PSO Best Distance:\", round(min(pso_curve), 2))\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 6. GRAPH 1: OPTIMAL TSP ROUTE\n",
        "# ==========================================\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "route = aco_route + [aco_route[0]]\n",
        "\n",
        "route_cities = cities[route]\n",
        "\n",
        "plt.plot(\n",
        "    route_cities[:, 0],\n",
        "    route_cities[:, 1],\n",
        "    'b-o',\n",
        "    linewidth=2,\n",
        "    markersize=6\n",
        ")\n",
        "\n",
        "for i, (x, y) in enumerate(cities):\n",
        "    plt.text(x + 1, y + 1, str(i))\n",
        "\n",
        "plt.title(\"Optimal Traveling Salesman Route - ACO\")\n",
        "plt.xlabel(\"X Coordinate\")\n",
        "plt.ylabel(\"Y Coordinate\")\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"ACO_TSP_Route.png\", dpi=300)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 7. GRAPH 2: ACO CONVERGENCE\n",
        "# ==========================================\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(\n",
        "    range(1, iterations + 1),\n",
        "    aco_curve,\n",
        "    color=\"blue\",\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.title(\"ACO Convergence Graph\")\n",
        "plt.xlabel(\"Number of Iterations\")\n",
        "plt.ylabel(\"Best Route Distance\")\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"ACO_Convergence.png\", dpi=300)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 8. GRAPH 3: ACO vs GA vs PSO\n",
        "# ==========================================\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.plot(\n",
        "    aco_curve,\n",
        "    label=\"ACO\",\n",
        "    linewidth=2,\n",
        "    color=\"blue\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    ga_curve,\n",
        "    label=\"Genetic Algorithm\",\n",
        "    linewidth=2,\n",
        "    color=\"red\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    pso_curve,\n",
        "    label=\"Particle Swarm Optimization\",\n",
        "    linewidth=2,\n",
        "    color=\"green\"\n",
        ")\n",
        "\n",
        "plt.title(\"Performance Comparison of Optimization Algorithms\")\n",
        "plt.xlabel(\"Number of Iterations\")\n",
        "plt.ylabel(\"Best Route Distance\")\n",
        "\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"ACO_GA_PSO_Comparison.png\", dpi=300)\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nAll three graphs generated successfully!\")"
      ]
